  gap: 10px;
}

/* Mini Quick Scroll Top */
.pf-quick-scroll-top {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(13, 19, 36, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  backdrop-filter: blur(15px);
  opacity: 0;
  visibility: hidden;
  transform: translateY(15px) scale(0.8);
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
.pf-quick-scroll-top.is-visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}
.pf-quick-scroll-top:hover {
  background: #00f2fe;
  color: #05070e;
  border-color: #00f2fe;
  transform: translateY(-3px) scale(1.08);
  box-shadow: 0 0 20px rgba(0, 242, 254, 0.5);
}

/* Google Gemini AI Trigger Button */
.pf-gemini-ai-btn {
  position: relative;
  height: 50px;
  padding: 0 18px 0 12px;
  border-radius: 100px;
  background: rgba(11, 17, 33, 0.94);
  border: 1px solid rgba(0, 242, 254, 0.45);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.8), 0 0 25px rgba(0, 242, 254, 0.2);
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.pf-gemini-ai-btn:hover {
  transform: translateY(-4px) scale(1.04);
  border-color: rgba(255, 0, 127, 0.7);
  box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.9), 0 0 35px rgba(155, 81, 224, 0.4);
}

.pf-gemini-halo {
  position: absolute;
  inset: -3px;
  border-radius: 100px;
  background: linear-gradient(135deg, #00f2fe, #4facfe, #9b51e0, #ff007f);
  filter: blur(8px);
  opacity: 0.35;
  transition: opacity 0.35s ease;
  z-index: -1;
  animation: haloShift 6s linear infinite;
}
@keyframes haloShift {
  0% { filter: blur(8px) hue-rotate(0deg); }
  100% { filter: blur(8px) hue-rotate(360deg); }
}
.pf-gemini-ai-btn:hover .pf-gemini-halo {
  opacity: 0.85;
}

/* Gemini Sparkle SVG Styling */
.pf-gemini-svg {
  width: 24px;
  height: 24px;
  filter: drop-shadow(0 0 6px rgba(0, 242, 254, 0.8));
  animation: geminiTwinkle 4s ease-in-out infinite;
}
.pf-gemini-svg-sm { width: 20px; height: 20px; }
.pf-gemini-svg-xs { width: 16px; height: 16px; }

@keyframes geminiTwinkle {
  0%, 100% { transform: scale(1) rotate(0deg); }
  50% { transform: scale(1.15) rotate(15deg); }
}

.pf-ai-btn-text {
  font-weight: 700;
  font-size: 0.9rem;
  letter-spacing: -0.01em;
  background: linear-gradient(135deg, #ffffff 40%, #00f2fe 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.pf-ai-online-pulse {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #00f2fe;
  box-shadow: 0 0 8px #00f2fe;
  animation: radarPulse 1.8s infinite;
}
@keyframes radarPulse {
  0% { transform: scale(0.9); opacity: 0.9; }
  50% { transform: scale(1.3); opacity: 0.4; }
  100% { transform: scale(0.9); opacity: 0.9; }
}

/* ==========================================================================
   AI ASSISTANT DRAWER WINDOW
   ========================================================================== */
.pf-ai-chat-window {
  position: fixed;
  bottom: 84px;
  right: 24px;
  width: min(390px, calc(100vw - 32px));
  height: 540px;
  max-height: calc(100vh - 110px);
  background: rgba(8, 13, 27, 0.95);
  border: 1px solid rgba(0, 242, 254, 0.35);
  backdrop-filter: blur(32px) saturate(180%);
  -webkit-backdrop-filter: blur(32px) saturate(180%);
  border-radius: 24px;
  box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.9), 0 0 35px rgba(0, 242, 254, 0.15);
  display: flex;
  flex-direction: column;
  z-index: 1080;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px) scale(0.95);
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}

.pf-ai-chat-window.is-open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}

.pf-ai-version-badge {
  background: rgba(0, 242, 254, 0.15);
  color: #00f2fe;
  border: 1px solid rgba(0, 242, 254, 0.3);
  font-size: 0.65rem;
  padding: 2px 6px;
}

.pf-ai-action-icon {
  background: transparent;
  border: none;
  color: rgba(255, 255, 255, 0.6);
  padding: 4px 6px;
  cursor: pointer;
  border-radius: 8px;
  transition: all 0.2s ease;
}
.pf-ai-action-icon:hover {
  color: #00f2fe;
  background: rgba(255, 255, 255, 0.05);
}

.pf-ai-avatar {
  width: 32px;
  height: 32px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(0, 242, 254, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pf-ai-body {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* Chat Message Bubbles */
.pf-ai-bubble-row {
  display: flex;
  gap: 10px;
  width: 100%;
}
.user-row { justify-content: flex-end; }
.ai-row { justify-content: flex-start; }

.pf-ai-msg-avatar {
  width: 24px;
  height: 24px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2px;
}

.pf-ai-bubble {
  max-width: 84%;
  padding: 11px 14px;
  border-radius: 16px;
  font-size: 0.85rem;
  line-height: 1.6;
  color: #fff;
  word-wrap: break-word;
}
.ai-bubble {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-top-left-radius: 4px;
}
.ai-bubble ul {
  padding-left: 18px;
  margin: 6px 0 0 0;
}
.ai-bubble code {
  background: rgba(0, 242, 254, 0.12);
  color: #00f2fe;
  padding: 2px 6px;
  border-radius: 4px;
  font-family: var(--font-mono, monospace);
  font-size: 0.8rem;
}
.user-bubble {
  background: linear-gradient(135deg, rgba(0, 242, 254, 0.35), rgba(79, 172, 254, 0.45));
  border: 1px solid rgba(0, 242, 254, 0.45);
  border-top-right-radius: 4px;
}

/* Thinking Indicator Animation */
.pf-thinking-dots {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
}
.pf-thinking-dots span:not(.pf-mono) {
  width: 5px;
  height: 5px;
  background-color: #00f2fe;
  border-radius: 50%;
  animation: bounceDot 1.4s infinite ease-in-out both;
}
.pf-thinking-dots span:nth-child(1) { animation-delay: -0.32s; }
.pf-thinking-dots span:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounceDot {
  0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
  40% { transform: scale(1); opacity: 1; }
}

/* Quick Suggestion Chips */
.pf-ai-chip {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: var(--pf-cyan);
  font-size: 0.72rem;
  font-weight: 600;
  padding: 5px 12px;
  border-radius: 100px;
  white-space: nowrap;
  cursor: pointer;
  transition: all 0.25s ease;
}
.pf-ai-chip:hover {
  background: rgba(0, 242, 254, 0.15);
  border-color: var(--pf-cyan);
  color: #ffffff;
  transform: translateY(-2px);
}

/* Input Form */
.pf-ai-input {
  font-size: 0.85rem;
  padding-left: 12px;
}
.pf-ai-input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}
.pf-ai-send-btn {
  background: transparent;
  border: none;
  color: var(--pf-cyan);
  transition: transform 0.2s ease, color 0.2s ease;
  padding-right: 12px;
}
.pf-ai-send-btn:hover {
  color: var(--pf-magenta);
  transform: scale(1.15);
}

.extra-small { font-size: 0.72rem; }
.text-cyan { color: #00f2fe !important; }
</style>

<!-- ===================== JAVASCRIPT & AI ENGINE ===================== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.1/aos.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  // 1. Initialize AOS & Dynamic Year
  if (typeof AOS !== 'undefined') {
    AOS.init({ duration: 900, easing: 'ease-out-cubic', once: true, offset: 60 });
  }
  const yearEl = document.getElementById('pfYear');
  if (yearEl) yearEl.textContent = new Date().getFullYear();

  // 2. Quick Scroll to Top
  const scrollTopBtn = document.getElementById('pfScrollTopBtn');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      scrollTopBtn.classList.add('is-visible');
    } else {
      scrollTopBtn.classList.remove('is-visible');
    }
  }, { passive: true });

  if (scrollTopBtn) {
    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // 3. Web Audio Tone Synthesizer for Interactive Sound FX
  let soundEnabled = true;
  const soundToggleBtn = document.getElementById('pfToggleSoundBtn');
  const soundIcon = document.getElementById('pfSoundIcon');

  const playChime = (freq = 600, duration = 0.08) => {
    if (!soundEnabled) return;
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      gain.gain.setValueAtTime(0.04, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + duration);
    } catch (e) {
      // Audio context ignored if user has not interacted
    }
  };

  soundToggleBtn.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    soundIcon.className = soundEnabled ? 'bi bi-volume-up-fill' : 'bi bi-volume-mute-fill';
    soundToggleBtn.title = soundEnabled ? 'Mute Sounds' : 'Unmute Sounds';
  });

  // 4. Interactive Google Gemini AI Assistant Brain
  const geminiBtn = document.getElementById('pfGeminiBtn');
  const chatWindow = document.getElementById('pfAiChatWindow');
  const closeAiBtn = document.getElementById('pfCloseAiBtn');
  const clearChatBtn = document.getElementById('pfClearChatBtn');
  const chatForm = document.getElementById('pfAiForm');
  const chatInput = document.getElementById('pfAiInput');
  const messagesBox = document.getElementById('pfAiMessages');
  const thinkingIndicator = document.getElementById('pfAiThinking');
  const suggestionChips = document.querySelectorAll('.pf-ai-chip');

  // Toggle Window
  geminiBtn.addEventListener('click', () => {
    chatWindow.classList.toggle('is-open');
    if (chatWindow.classList.contains('is-open')) {
      playChime(750, 0.1);
      setTimeout(() => chatInput.focus(), 200);
    }
  });

  closeAiBtn.addEventListener('click', () => {
    chatWindow.classList.remove('is-open');
  });

  // Clear Chat History
  clearChatBtn.addEventListener('click', () => {
    messagesBox.innerHTML = `
      <div class="pf-ai-bubble-row ai-row">
        <div class="pf-ai-msg-avatar">
          <svg class="pf-gemini-svg-xs" viewBox="0 0 24 24">
            <path d="M12 0C12 6.627 6.627 12 0 12C6.627 12 12 17.373 12 24C12 17.373 17.373 12 24 12C17.373 12 12 6.627 12 0Z" fill="url(#geminiGrad)" />
          </svg>
        </div>
        <div class="pf-ai-bubble ai-bubble">
          Conversation reset. Ask me anything about Mohit's background, technical stack, or project solutions!
        </div>
      </div>`;
    playChime(400, 0.08);
  });

  // Knowledge Matching Engine
  const generateAiReply = (question) => {
    const q = question.toLowerCase();

    if (q.includes('skill') || q.includes('stack') || q.includes('technolog') || q.includes('tool')) {
      return `Here is a breakdown of <strong>Mohit's Core Tech Stack</strong>:<br>
      <ul>
        <li><strong>Backend:</strong> <code>Node.js</code>, <code>Express.js</code>, RESTful APIs, JWT Auth</li>
        <li><strong>Databases:</strong> <code>MySQL</code>, <code>PostgreSQL</code>, <code>MongoDB</code></li>
        <li><strong>Caching &amp; Cloud:</strong> <code>Redis</code>, basic CI/CD, Git</li>
        <li><strong>Frontend:</strong> Modern JavaScript (ES6+), EJS, Bootstrap 5, Glassmorphism</li>
      </ul>`;
    }

    if (q.includes('educat') || q.includes('bca') || q.includes('colleg') || q.includes('degre') || q.includes('study')) {
      return `Mohit is pursuing a <strong>Bachelor of Computer Applications (BCA)</strong>.<br>
      He has successfully completed <strong>4 Semesters</strong> with a heavy focus on:
      <ul>
        <li>Relational Database Management Systems (RDBMS)</li>
        <li>Object-Oriented Programming &amp; Data Structures</li>
        <li>Server-side web engineering and API design</li>
      </ul>`;
    }

    if (q.includes('project') || q.includes('work') || q.includes('portfolio') || q.includes('build') || q.includes('built')) {
      return `Mohit has engineered several production-grade applications:<br>
      <ul>
        <li><strong>Secure REST API Services:</strong> Role-based access control with JWT encryption</li>
        <li><strong>Database Normalization Modules:</strong> High-performance SQL schema design</li>
        <li><strong>Full-Stack EJS Applications:</strong> Dynamic web apps with server-side rendering</li>
      </ul>
      You can scroll up to the <strong>#projects</strong> section to test live demos!`;
    }

    if (q.includes('database') || q.includes('sql') || q.includes('mongo') || q.includes('postgres') || q.includes('mysql')) {
      return `Mohit works with both <strong>Relational &amp; NoSQL</strong> databases:<br>
      <ul>
        <li><strong>MySQL &amp; PostgreSQL:</strong> Normalized schemas, indexing, foreign keys, transaction ACID safety</li>
        <li><strong>MongoDB:</strong> Schema-less document storage, aggregations, and Mongoose modeling</li>
        <li><strong>Redis:</strong> In-memory caching for sub-millisecond route response times</li>
      </ul>`;
    }

    if (q.includes('contact') || q.includes('hire') || q.includes('email') || q.includes('phone') || q.includes('whatsapp') || q.includes('call') || q.includes('number')) {
      return `You can connect with Mohit directly via:<br>
      <ul>
        <li><strong>WhatsApp:</strong> <a href="https://wa.me/918000225896" target="_blank" class="text-cyan fw-bold text-decoration-underline">+91 8000225896</a></li>
        <li><strong>Email:</strong> <a href="mailto:contact@mohitsoni.dev" class="text-cyan fw-bold text-decoration-underline">contact@mohitsoni.dev</a></li>
        <li><strong>Status:</strong> Actively open for full-time backend and contract opportunities.</li>
      </ul>`;
    }

    if (q.includes('where') || q.includes('locat') || q.includes('city') || q.includes('state') || q.includes('live')) {
      return `Mohit is located in <strong>Deesa, Gujarat, India</strong>. He is available for <strong>remote developer roles globally</strong> or on-site opportunities across India.`;
    }

    if (q.includes('who is') || q.includes('kon hai') || q.includes('about')) {
      return `<strong>Mohit Soni</strong> is a dedicated BCA student and backend engineer specializing in <code>Node.js</code>, clean API architectures, and modern web application development.`;
    }

    return `Thank you for your question! Mohit is an engineer dedicated to server-side reliability, API performance, and scalable databases. For inquiries or customized projects, you can message him directly on WhatsApp at <a href="https://wa.me/918000225896" target="_blank" class="text-cyan fw-bold">+91 8000225896</a>.`;
  };

  // Append User / AI Message
  const appendMessage = (sender, contentHtml) => {
    const row = document.createElement('div');
    row.className = `pf-ai-bubble-row ${sender === 'user' ? 'user-row' : 'ai-row'}`;

    if (sender === 'ai') {
      const avatar = document.createElement('div');
      avatar.className = 'pf-ai-msg-avatar';
      avatar.innerHTML = `
        <svg class="pf-gemini-svg-xs" viewBox="0 0 24 24">
          <path d="M12 0C12 6.627 6.627 12 0 12C6.627 12 12 17.373 12 24C12 17.373 17.373 12 24 12C17.373 12 12 6.627 12 0Z" fill="url(#geminiGrad)" />
        </svg>`;
      row.appendChild(avatar);
    }

    const bubble = document.createElement('div');
    bubble.className = `pf-ai-bubble ${sender === 'user' ? 'user-bubble' : 'ai-bubble'}`;
    
    if (sender === 'user') {
      bubble.textContent = contentHtml;
      row.appendChild(bubble);
      messagesBox.appendChild(row);
      messagesBox.scrollTop = messagesBox.scrollHeight;
    } else {
      bubble.innerHTML = '';
      row.appendChild(bubble);
      messagesBox.appendChild(row);

      // Smooth streaming simulation
      bubble.innerHTML = contentHtml;
      messagesBox.scrollTop = messagesBox.scrollHeight;
      playChime(850, 0.08);
    }
  };

  // Submit Query
  const handleQuery = (queryText) => {
    if (!queryText.trim()) return;
    
    playChime(500, 0.06);
    appendMessage('user', queryText);
    chatInput.value = '';

    // Show Thinking indicator
    thinkingIndicator.classList.remove('d-none');
    messagesBox.scrollTop = messagesBox.scrollHeight;

    setTimeout(() => {
      thinkingIndicator.classList.add('d-none');
      const answer = generateAiReply(queryText);
      appendMessage('ai', answer);
    }, 450);
  };

  chatForm.addEventListener('submit', (e) => {
    e.preventDefault();
    handleQuery(chatInput.value);
  });

  // Suggestion Chips Click
  suggestionChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const query = chip.getAttribute('data-query');
      handleQuery(query);
    });
  });
});
</script>
</body>
</html>