<!-- ===================== CSS STYLES ===================== -->
<style>
/* Universal Box Sizing Guard */
*, *::before, *::after {
  box-sizing: border-box;
}

:root {
  --pf-cyan: #00f2fe;
  --pf-blue: #4facfe;
  --pf-purple: #7f00ff;
  --pf-magenta: #ff007f;
  --pf-bg-dark: #070b14;
  --pf-glass-bg: rgba(13, 19, 33, 0.75);
  --pf-border-cyan: rgba(0, 242, 254, 0.25);
}

.pf-cyber-footer {
  background: var(--pf-bg-dark);
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.pf-footer-horizon {
  height: 2px;
  background: linear-gradient(90deg, transparent 0%, var(--pf-cyan) 30%, var(--pf-purple) 70%, transparent 100%);
  box-shadow: 0 0 25px 2px var(--pf-cyan);
}

.pf-glow-blob {
  border-radius: 50%;
  filter: blur(140px);
  z-index: 1;
}
.pf-glow-cyan {
  width: 500px;
  height: 260px;
  top: -80px;
  left: 20%;
  background: radial-gradient(circle, rgba(0, 242, 254, 0.16) 0%, transparent 70%);
}
.pf-glow-purple {
  width: 450px;
  height: 350px;
  bottom: 0;
  right: 5%;
  background: radial-gradient(circle, rgba(127, 0, 255, 0.12) 0%, transparent 70%);
}

.pf-3d-banner {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.01));
  border: 1px solid rgba(0, 242, 254, 0.3);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
}
.pf-3d-banner:hover {
  transform: translateY(-4px) scale(1.008);
  border-color: rgba(0, 242, 254, 0.6);
  box-shadow: 0 35px 65px -15px rgba(0, 242, 254, 0.25);
}

.pf-shimmer-sweep {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 40%, rgba(255, 255, 255, 0.08) 50%, transparent 60%);
  transform: rotate(25deg);
  animation: shimmerFlow 8s infinite linear;
  pointer-events: none;
}
@keyframes shimmerFlow {
  0% { transform: translateX(-60%) rotate(25deg); }
  100% { transform: translateX(60%) rotate(25deg); }
}

.pf-live-status-pill {
  background: rgba(16, 185, 129, 0.12);
  border: 1px solid rgba(16, 185, 129, 0.35);
  color: #34d399;
}
.pf-ping-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 10px #10b981;
  animation: pingPulse 1.8s infinite;
}
@keyframes pingPulse {
  0% { transform: scale(0.9); opacity: 0.4; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0.4; }
}

.pf-btn-3d {
  background: linear-gradient(135deg, #00f2fe, #4facfe);
  color: #070b14;
  border: none;
  box-shadow: 0 12px 25px rgba(0, 242, 254, 0.35);
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.pf-btn-3d:hover {
  transform: translateY(-3px) scale(1.04);
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  color: #070b14;
  box-shadow: 0 18px 35px rgba(0, 242, 254, 0.55);
}
.pf-bounce-arrow { transition: transform 0.3s ease; }
.pf-btn-3d:hover .pf-bounce-arrow { transform: translate(2px, -2px); }

.pf-brand-cube {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(0, 242, 254, 0.15), rgba(79, 172, 254, 0.25));
  border: 1px solid rgba(0, 242, 254, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pf-cyan);
  font-size: 1.25rem;
  box-shadow: 0 0 15px rgba(0, 242, 254, 0.3);
  transition: all 0.4s ease;
}
.pf-brand-badge-wrapper:hover .pf-brand-cube {
  transform: rotate(15deg) scale(1.1);
  box-shadow: 0 0 25px var(--pf-cyan);
}
.pf-glow-text {
  background: linear-gradient(135deg, #00f2fe, #4facfe);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 0 20px rgba(0, 242, 254, 0.4);
}

.pf-social-3d {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  text-decoration: none;
  position: relative;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.pf-social-tooltip {
  position: absolute;
  top: -36px;
  left: 50%;
  transform: translateX(-50%) translateY(5px);
  background: #0f172a;
  border: 1px solid var(--pf-border-cyan);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 6px;
  opacity: 0;
  pointer-events: none;
  transition: all 0.25s ease;
  white-space: nowrap;
}
.pf-social-3d:hover .pf-social-tooltip {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
.pf-social-wa:hover { background: #25d366; color: #fff; box-shadow: 0 10px 25px rgba(37, 211, 102, 0.5); transform: translateY(-5px) scale(1.1); }
.pf-social-mail:hover { background: #00f2fe; color: #000; box-shadow: 0 10px 25px rgba(0, 242, 254, 0.5); transform: translateY(-5px) scale(1.1); }
.pf-social-gh:hover { background: #6e5494; color: #fff; box-shadow: 0 10px 25px rgba(110, 84, 148, 0.5); transform: translateY(-5px) scale(1.1); }
.pf-social-in:hover { background: #0a66c2; color: #fff; box-shadow: 0 10px 25px rgba(10, 102, 194, 0.5); transform: translateY(-5px) scale(1.1); }

.pf-footer-column-header { display: flex; align-items: center; gap: 10px; }
.pf-header-laser {
  width: 4px;
  height: 16px;
  background: linear-gradient(180deg, #00f2fe, #4facfe);
  border-radius: 4px;
  box-shadow: 0 0 10px #00f2fe;
}

.pf-3d-link {
  font-size: 0.88rem;
  color: rgba(255, 255, 255, 0.65) !important;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.pf-link-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}
.pf-3d-link:hover {
  color: #00f2fe !important;
  transform: translateX(6px);
  text-shadow: 0 0 10px rgba(0, 242, 254, 0.4);
}
.pf-3d-link:hover .pf-link-dot {
  background: #00f2fe;
  box-shadow: 0 0 8px #00f2fe;
  transform: scale(1.6);
}

.pf-input-3d-shell {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(0, 242, 254, 0.3);
  backdrop-filter: blur(20px);
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4);
  transition: all 0.4s ease;
}
.pf-input-3d-shell:focus-within {
  border-color: #00f2fe;
  box-shadow: 0 0 25px rgba(0, 242, 254, 0.35);
}
.pf-btn-send {
  background: linear-gradient(135deg, #00f2fe, #3a7bd5);
  color: #fff;
  border: none;
  transition: all 0.3s ease;
}
.pf-btn-send:hover {
  background: linear-gradient(135deg, #3a7bd5, #00f2fe);
  transform: scale(1.05);
  box-shadow: 0 0 15px rgba(0, 242, 254, 0.5);
}

.pf-neon-divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(0, 242, 254, 0.3), transparent);
}

