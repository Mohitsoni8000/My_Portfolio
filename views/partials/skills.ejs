<!-- Scoped Styling Sheet -->
<style>
/* Capsule Header Badge */
.pf-capsule-badge {
  background: rgba(0, 242, 254, 0.08);
  border: 1px solid rgba(0, 242, 254, 0.3);
  border-radius: 9999px;
  color: #00f2fe;
}
.pf-pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #00f2fe;
  box-shadow: 0 0 10px #00f2fe;
  animation: pfPulse 1.8s infinite;
}
@keyframes pfPulse {
  0% { transform: scale(0.9); opacity: 0.4; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0.4; }
}

.pf-gradient-title {
  background: linear-gradient(135deg, #ffffff 40%, rgba(255, 255, 255, 0.65) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* Base Interactive Card */
.pf-skill-item {
  position: relative;
  border-radius: 22px;
  padding: 1px;
  cursor: pointer;
  user-select: none;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
}

.pf-skill-card-inner {
  background: rgba(13, 18, 30, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 21px;
  padding: 24px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.06);
  position: relative;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Category Badge */
.pf-skill-badge {
  position: absolute;
  top: 14px;
  right: 14px;
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 3px 8px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

/* Icon Shell */
.pf-icon-box {
  width: 68px;
  height: 68px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  color: var(--skill-color);
  background: radial-gradient(circle, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  margin-bottom: 16px;
  transition: all 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
}

.pf-skill-name {
  color: #ffffff;
  font-weight: 700;
  font-size: 1.15rem;
  margin-bottom: 2px;
}

.pf-skill-role {
  color: rgba(255, 255, 255, 0.55);
  font-size: 0.8rem;
  font-family: monospace;
}

/* Progress Track */
.pf-progress-track {
  width: 100%;
  height: 6px;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 10px;
  overflow: hidden;
}

.pf-progress-bar {
  height: 100%;
  border-radius: 10px;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.2), var(--skill-color));
  box-shadow: 0 0 10px var(--skill-glow);
  transition: width 1s cubic-bezier(0.16, 1, 0.3, 1);
}

.pf-status-text {
  font-size: 0.72rem;
  font-weight: 700;
}

/* ================= Hover Effects ================= */
.pf-skill-item:hover {
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 20px 35px -10px var(--skill-glow);
}

.pf-skill-item:hover .pf-skill-card-inner {
  border-color: var(--skill-color);
  background: rgba(16, 23, 38, 0.95);
}

.pf-skill-item:hover .pf-icon-box {
  transform: scale(1.15) rotate(6deg);
  background: var(--skill-color);
  color: #0d121e;
  border-color: var(--skill-color);
  box-shadow: 0 0 25px var(--skill-color);
}

.pf-skill-item:hover .pf-progress-bar {
  filter: brightness(1.25);
  box-shadow: 0 0 16px var(--skill-color);
}

/* ================= Active Tap & Click Animation ================= */
.pf-skill-item:active,
.pf-skill-item.active-tap {
  transform: scale(0.96);
  transition: transform 0.15s ease;
}

.pf-skill-item.active-tap .pf-skill-card-inner {
  box-shadow: inset 0 0 20px var(--skill-glow);
}
</style>

<!-- Mobile Touch & Tap Interaction Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.pf-skill-item');

    cards.forEach(card => {
      // Tap/click feedback
      card.addEventListener('click', function () {
        cards.forEach(c => { if (c !== card) c.classList.remove('active-tap'); });
        this.classList.toggle('active-tap');
      });

      // Reset when clicking outside
      document.addEventListener('click', (e) => {
        if (!card.contains(e.target)) {
          card.classList.remove('active-tap');
        }
      });
    });
  });
</script>