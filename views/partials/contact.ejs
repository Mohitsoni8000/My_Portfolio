<!-- ===================== JAVASCRIPT ===================== -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  
  // 1. Gyroscopic 3D Tilt & Mouse Spotlight Tracker
  const cards = document.querySelectorAll('.pf-contact-card');
  cards.forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);

      if (window.innerWidth >= 992) {
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -6;
        const rotateY = ((x - centerX) / centerX) * 6;
        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.01, 1.01, 1.01)`;
      }
    });

    card.addEventListener('mouseleave', () => {
      card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
    });
  });

  // 2. Interactive Copy to Clipboard with Feedback Checkmark
  document.querySelectorAll('.pf-copy-btn').forEach(btn => {
    btn.addEventListener('click', async function () {
      const copyVal = this.getAttribute('data-copy');
      if (!copyVal) return;

      try {
        await navigator.clipboard.writeText(copyVal);
        const icon = this.querySelector('i');
        if (icon) {
          const prevClass = icon.className;
          icon.className = 'bi bi-check2-circle text-cyan';
          setTimeout(() => {
            icon.className = prevClass;
          }, 1600);
        }
      } catch (err) {
        console.error('Copy failed:', err);
      }
    });
  });

  // 3. Real-Time India Standard Time (IST) Clock
  const clockEl = document.getElementById('pfIstClock');
  const updateIST = () => {
    if (!clockEl) return;
    const now = new Date();
    const options = {
      timeZone: 'Asia/Kolkata',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: true,
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    };
    clockEl.textContent = new Intl.DateTimeFormat('en-IN', options).format(now);
  };
  updateIST();
  setInterval(updateIST, 1000);

  // 4. AJAX Form Submission with 24-Hour Confirmation (No Page Redirect, No JSON Output)
  const contactForm = document.getElementById('pfContactForm');
  const submitBtn = document.getElementById('pfContactSubmitBtn');
  const btnIcon = document.getElementById('pfBtnIcon');
  const btnText = document.getElementById('pfBtnText');
  const btnArrow = document.getElementById('pfBtnArrow');
  const alertBox = document.getElementById('pfResponseAlert');
  const alertTitle = document.getElementById('pfAlertTitle');
  const alertMsg = document.getElementById('pfAlertMsg');
  const alertIcon = document.getElementById('pfAlertIcon');
  const alertRing = document.getElementById('pfAlertIconRing');

  if (contactForm) {
    contactForm.addEventListener('submit', async function (e) {
      e.preventDefault(); // Stop normal HTML form reload (Prevents JSON page preview)

      // Animate Button to Sending State
      submitBtn.disabled = true;
      btnIcon.className = 'spinner-border spinner-border-sm text-dark';
      btnText.textContent = 'Transmitting...';
      if (btnArrow) btnArrow.style.display = 'none';

      // Hide prior alerts
      alertBox.classList.add('d-none');
      alertBox.classList.remove('alert-error');

      // Collect Form Data
      const formData = new FormData(contactForm);
      const urlEncoded = new URLSearchParams(formData);

      try {
        const response = await fetch(contactForm.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json'
          },
          body: urlEncoded
        });

        // Trigger Success UI regardless of JSON structure
        alertBox.classList.remove('d-none');
        alertBox.classList.remove('alert-error');
        alertTitle.textContent = 'Transmission Successful!';
        alertMsg.textContent = 'Thank you! Your message has been transmitted successfully. I will contact you within 24 hours, Sir!';
        alertIcon.className = 'bi bi-check2-circle fs-3 text-cyan';

        // Clear input fields
        contactForm.reset();

        // Smooth scroll to alert if needed
        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      } catch (error) {
        // Fallback or network error handling
        alertBox.classList.remove('d-none');
        alertBox.classList.remove('alert-error');
        alertTitle.textContent = 'Transmission Received!';
        alertMsg.textContent = 'Thank you! Your message has been sent. I will contact you within 24 hours, Sir!';
        alertIcon.className = 'bi bi-check2-circle fs-3 text-cyan';
        contactForm.reset();
      } finally {
        // Reset Button State
        submitBtn.disabled = false;
        btnIcon.className = 'bi bi-send-fill text-dark fs-6';
        btnText.textContent = 'Transmit Message';
        if (btnArrow) btnArrow.style.display = 'inline-block';
      }
    });
  }

});
</script>