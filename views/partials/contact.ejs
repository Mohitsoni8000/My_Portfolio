<!-- ===================== views/partials/contact.ejs ===================== -->
<section id="contact" class="pf-contact-section py-5 position-relative overflow-hidden">
  
  <!-- Cybernetic Multi-Point Ambient Lighting Glows -->
  <div class="pf-contact-glow-orb orb-cyan"></div>
  <div class="pf-contact-glow-orb orb-blue"></div>
  <div class="pf-contact-glow-orb orb-magenta"></div>
  <div class="pf-contact-grid-mesh"></div>

  <div class="container pf-contact-container position-relative" style="z-index: 2;">
    
    <!-- Section Header -->
    <div class="text-center mx-auto mb-5 pf-contact-heading" data-aos="fade-down" data-aos-duration="1000">
      <div class="pf-contact-badge mb-3">
        <span class="pf-contact-radar-dot"></span>
        <span>GET IN TOUCH</span>
      </div>
      <h2 class="pf-contact-title display-4 fw-bold">
        Let's Build Something <span class="pf-contact-gradient-text">Great.</span>
      </h2>
      <p class="pf-contact-subtitle text-light opacity-75 mx-auto lead fs-6">
        Have a backend architecture, scalable REST API, Node.js project, or collaboration in mind? Leave a message or connect directly.
      </p>
    </div>

    <!-- Main Contact 3D Grid -->
    <div class="row g-4 align-items-stretch">
      
      <!-- Left Column: Interactive Contact Channels & Telemetry -->
      <div class="col-lg-5" data-aos="fade-right" data-aos-duration="1000">
        <div class="pf-contact-card h-100 p-4 p-md-5 d-flex flex-column justify-content-between">
          <div class="pf-card-spotlight"></div>
          
          <div class="position-relative" style="z-index: 2;">
            <div class="d-flex align-items-center gap-2 mb-3">
              <span class="pf-header-laser-accent"></span>
              <h3 class="pf-info-title text-light fw-bold fs-4 mb-0">Direct Channels</h3>
            </div>
            <p class="text-light opacity-75 small mb-4 line-height-lg">
              Always open for discussions about backend performance, normalized databases, microservices, and software engineering roles.
            </p>

            <!-- Channel 1: Email -->
            <div class="pf-channel-item d-flex align-items-center justify-content-between p-3 rounded-4 mb-3">
              <div class="d-flex align-items-center gap-3 min-w-0">
                <div class="pf-channel-icon-box flex-shrink-0">
                  <i class="bi bi-envelope-at-fill text-cyan"></i>
                </div>
                <div class="min-w-0">
                  <span class="pf-channel-label font-monospace text-uppercase extra-small">Official Email</span>
                  <a href="mailto:contact@mohitsoni.dev" class="pf-channel-value d-block text-truncate text-light fw-semibold text-decoration-none">
                    contact@mohitsoni.dev
                  </a>
                </div>
              </div>
              <button type="button" class="pf-copy-btn flex-shrink-0 ms-2" data-copy="contact@mohitsoni.dev" title="Copy Email">
                <i class="bi bi-copy"></i>
              </button>
            </div>

            <!-- Channel 2: WhatsApp / Call -->
            <div class="pf-channel-item d-flex align-items-center justify-content-between p-3 rounded-4 mb-3">
              <div class="d-flex align-items-center gap-3 min-w-0">
                <div class="pf-channel-icon-box flex-shrink-0">
                  <i class="bi bi-whatsapp text-success"></i>
                </div>
                <div class="min-w-0">
                  <span class="pf-channel-label font-monospace text-uppercase extra-small">Direct WhatsApp</span>
                  <a href="https://wa.me/918000225896" target="_blank" rel="noopener noreferrer" class="pf-channel-value d-block text-truncate text-light fw-semibold text-decoration-none">
                    +91 80002 25896
                  </a>
                </div>
              </div>
              <button type="button" class="pf-copy-btn flex-shrink-0 ms-2" data-copy="+918000225896" title="Copy Number">
                <i class="bi bi-copy"></i>
              </button>
            </div>

            <!-- Channel 3: Location -->
            <div class="pf-channel-item d-flex align-items-center p-3 rounded-4 mb-4">
              <div class="pf-channel-icon-box flex-shrink-0 me-3">
                <i class="bi bi-geo-alt-fill text-magenta"></i>
              </div>
              <div>
                <span class="pf-channel-label font-monospace text-uppercase extra-small">Location</span>
                <span class="pf-channel-value d-block text-light fw-semibold">Deesa, Gujarat, India</span>
              </div>
            </div>

            <!-- WhatsApp Instant Ping Button -->
            <a href="https://wa.me/918000225896?text=Hello%20Mohit,%20I%20reviewed%20your%20portfolio%20and%20would%20like%20to%20connect!" 
               target="_blank" 
               rel="noopener noreferrer" 
               class="pf-whatsapp-action-btn w-100 py-3 px-4 rounded-pill d-flex align-items-center justify-content-center gap-2 text-decoration-none fw-bold shadow-lg">
              <i class="bi bi-whatsapp fs-5"></i>
              <span>Quick Chat on WhatsApp</span>
              <i class="bi bi-arrow-up-right-short fs-4"></i>
            </a>
          </div>

          <!-- Bottom Telemetry & IST Clock -->
          <div class="pt-4 mt-4 border-top border-white border-opacity-10 position-relative" style="z-index: 2;">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <span class="pf-telemetry-pulse"></span>
                <span class="text-light opacity-75 extra-small font-monospace">STATUS: AVAILABLE FOR CONTRACT</span>
              </div>
            </div>
