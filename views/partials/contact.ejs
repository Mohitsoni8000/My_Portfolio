                </div>

                <!-- Input: Email -->
                <div class="col-md-6">
                  <label class="pf-cyber-label mb-2">YOUR EMAIL</label>
                  <div class="pf-cyber-input-wrap d-flex align-items-center">
                    <i class="bi bi-envelope-fill text-cyan ps-3 fs-6"></i>
                    <input type="email" 
                           name="email" 
                           class="form-control pf-cyber-input border-0 bg-transparent text-light px-3 py-3 shadow-none" 
                           placeholder="mohit@example.com" 
                           autocomplete="email" 
                           required>
                  </div>
                </div>

                <!-- Input: Mobile Number -->
                <div class="col-12">
                  <label class="pf-cyber-label mb-2">PHONE / WHATSAPP NUMBER</label>
                  <div class="pf-cyber-input-wrap d-flex align-items-center">
                    <i class="bi bi-telephone-fill text-cyan ps-3 fs-6"></i>
                    <input type="tel" 
                           name="mobile" 
                           class="form-control pf-cyber-input border-0 bg-transparent text-light px-3 py-3 shadow-none" 
                           placeholder="+91 80002 25896" 
                           autocomplete="tel">
                  </div>
                </div>

                <!-- Input: Project Scope Message -->
                <div class="col-12">
                  <label class="pf-cyber-label mb-2">PROJECT SCOPE &amp; DETAILS</label>
                  <div class="pf-cyber-input-wrap d-flex align-items-start py-2">
                    <i class="bi bi-chat-square-code-fill text-cyan ps-3 pt-2 fs-6"></i>
                    <textarea name="message" 
                              rows="5" 
                              class="form-control pf-cyber-input border-0 bg-transparent text-light px-3 py-2 shadow-none" 
                              placeholder="Detail your backend architecture requirements, REST APIs, or frontend goals..." 
