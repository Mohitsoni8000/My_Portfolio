        <div class="pf-contact-card h-100 p-4 p-md-5 position-relative">
          <div class="pf-card-spotlight"></div>
          
          <div class="position-relative" style="z-index: 2;">
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="pf-header-laser-accent"></span>
              <h3 class="pf-form-title text-light fw-bold fs-4 mb-0">Transmit Message</h3>
            </div>
            <p class="text-light opacity-75 small mb-4">
              Send your project specifications, queries, or ideas. All inquiries trigger direct developer notification.
            </p>

            <!-- Interactive In-Card Feedback Alert (No JSON, No Redirect) -->
            <div class="pf-response-alert d-none mb-4 p-3 rounded-4" id="pfResponseAlert">
              <div class="d-flex align-items-center gap-3">
                <div class="pf-alert-icon-ring flex-shrink-0" id="pfAlertIconRing">
