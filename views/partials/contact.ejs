            <!-- Form -->
            <form action="/Contact/contact1" method="POST" class="pf-contact-form" id="pfContactForm">
              <div class="row g-3">
                
                <!-- Input: Full Name -->
                <div class="col-md-6">
                  <label class="pf-cyber-label mb-2">YOUR NAME</label>
                  <div class="pf-cyber-input-wrap d-flex align-items-center">
                    <i class="bi bi-person-fill text-cyan ps-3 fs-6"></i>
                    <input type="text" 
                           name="name" 
                           class="form-control pf-cyber-input border-0 bg-transparent text-light px-3 py-3 shadow-none" 
                           placeholder="e.g. Mohit Soni" 
                           autocomplete="name" 
                           required>
