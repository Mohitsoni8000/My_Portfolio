<!-- ===================== views/partials/preloader.ejs ===================== -->
<div id="pfPreloader" class="pf-preloader-curtain" aria-hidden="false">
  <!-- Multi-Point Atmospheric Glow Mesh -->
  <div class="preloader-glow-orb orb-cyan"></div>
  <div class="preloader-glow-orb orb-magenta"></div>
  <div class="preloader-glow-orb orb-blue"></div>
  <div class="preloader-grid-bg"></div>

  <!-- Central Kinetic Reveal Stage -->
  <div class="pf-preloader-stage text-center position-relative">
    
    <!-- 3D Holographic Gemini Reactor -->
    <div class="pf-preloader-gemini-wrap mb-3 mb-md-4">
      <div class="gemini-spin-ring ring-outer"></div>
      <div class="gemini-spin-ring ring-inner"></div>
      <div class="gemini-core-glow"></div>
      
      <!-- Authentic Google Gemini 4-Point Sparkle Icon -->
      <svg class="pf-gemini-loader-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="preloaderGeminiGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#00f2fe" />
            <stop offset="30%" stop-color="#4facfe" />
            <stop offset="65%" stop-color="#9b51e0" />
            <stop offset="100%" stop-color="#ff007f" />
          </linearGradient>
        </defs>
        <path d="M12 0C12 6.627 6.627 12 0 12C6.627 12 12 17.373 12 24C12 17.373 17.373 12 24 12C17.373 12 12 6.627 12 0Z" fill="url(#preloaderGeminiGrad)" />
      </svg>
    </div>

    <!-- Cinematic Name & Eyebrow Stage -->
    <div class="pf-preloader-title-box position-relative">
      
      <!-- Top Glowing Status Eyebrow -->
      <div class="d-inline-flex align-items-center gap-2 mb-2">
        <span class="pf-preloader-dot"></span>
        <span class="pf-preloader-eyebrow font-monospace">// SYSTEM INITIALIZATION</span>
      </div>

      <!-- Laser Scanner Beam Above Name -->
      <div class="pf-name-laser-beam top-laser"></div>

      <!-- Main Animated Display Name -->
      <h1 class="pf-preloader-name" aria-label="Mohit Soni">
        <span class="name-word word-first">
          <span class="p-char" style="--d:1">M</span>
          <span class="p-char" style="--d:2">O</span>
          <span class="p-char" style="--d:3">H</span>
          <span class="p-char" style="--d:4">I</span>
          <span class="p-char" style="--d:5">T</span>
        </span>
        <span class="p-space">&nbsp;</span>
        <span class="name-word word-second">
          <span class="p-char p-accent" style="--d:6">S</span>
          <span class="p-char p-accent" style="--d:7">O</span>
          <span class="p-char p-accent" style="--d:8">N</span>
          <span class="p-char p-accent" style="--d:9">I</span>
        </span>
        <span class="pf-sparkle-star">✦</span>
      </h1>

      <!-- Laser Scanner Beam Below Name -->
      <div class="pf-name-laser-beam bottom-laser"></div>

      <!-- Terminal Sub-Badge -->
      <p class="pf-preloader-sub font-monospace mt-2 mb-0">
        <span class="text-cyan">&lt;</span> BACKEND &amp; NODE.JS ARCHITECT <span class="text-cyan">/&gt;</span>
      </p>
    </div>

    <!-- Smooth Real-Time Progress Bar & Boot Status -->
    <div class="pf-preloader-progress-wrap mt-4 mx-auto">
      <div class="d-flex justify-content-between align-items-center mb-2 font-monospace">
        <span class="text-light opacity-75 small pf-status-line" id="pfBootStatus">INITIALIZING CORE ARCHITECTURE...</span>
        <span class="text-cyan fw-bold small ms-2" id="pfBootPercent">0%</span>
      </div>
      <div class="pf-preloader-bar-track">
        <div class="pf-preloader-bar-fill" id="pfBootBar">
          <span class="pf-bar-laser"></span>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ===================== STYLES ===================== -->
<style>
/* Fullscreen Curtain Container */
.pf-preloader-curtain {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  background: #04060d !important;
  z-index: 999999 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  overflow: hidden !important;
  transition: transform 1s cubic-bezier(0.85, 0, 0.15, 1), opacity 0.85s ease !important;
}

/* Shutter Exit Trigger */
.pf-preloader-curtain.loaded {
  transform: translateY(-100%) !important;
  opacity: 0 !important;
  pointer-events: none !important;
}

/* Background Cyber Grid */
.preloader-grid-bg {
  position: absolute;
  inset: 0;
  background-image: 
    linear-gradient(to right, rgba(0, 242, 254, 0.05) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(0, 242, 254, 0.05) 1px, transparent 1px);
  background-size: 55px 55px;
  mask-image: radial-gradient(circle at center, black 45%, transparent 85%);
  -webkit-mask-image: radial-gradient(circle at center, black 45%, transparent 85%);
  pointer-events: none;
}

/* Atmospheric Glow Orbs */
.preloader-glow-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(140px);
  pointer-events: none;
  mix-blend-mode: screen;
}
.orb-cyan {
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(0, 242, 254, 0.22) 0%, transparent 70%);
  top: 10%;
  left: 15%;
  animation: floatOrb 8s ease-in-out infinite alternate;
}
.orb-magenta {
  width: 520px;
  height: 520px;
  background: radial-gradient(circle, rgba(255, 0, 127, 0.18) 0%, transparent 70%);
  bottom: 10%;
  right: 15%;
  animation: floatOrb 10s ease-in-out infinite alternate-reverse;
}
.orb-blue {
  width: 380px;
  height: 380px;
  background: radial-gradient(circle, rgba(79, 172, 254, 0.2) 0%, transparent 70%);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
@keyframes floatOrb {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(30px, 40px) scale(1.1); }
}

/* Holographic 3D Gemini Reactor */
.pf-preloader-gemini-wrap {
  position: relative;
  width: 76px;
  height: 76px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 600px;
}
.gemini-spin-ring {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.ring-outer {
  inset: -8px;
  border: 2px dashed rgba(0, 242, 254, 0.6);
  animation: reactorSpinCW 14s linear infinite;
}
.ring-inner {
  inset: -2px;
  border: 1px dotted rgba(255, 0, 127, 0.55);
  animation: reactorSpinCCW 10s linear infinite;
}
.gemini-core-glow {
  position: absolute;
  inset: 10px;
  background: radial-gradient(circle, rgba(0, 242, 254, 0.35) 0%, transparent 70%);
  filter: blur(8px);
}
.pf-gemini-loader-svg {
  width: 48px;
  height: 48px;
  filter: drop-shadow(0 0 16px rgba(0, 242, 254, 0.85));
  animation: geminiBreath 2.8s infinite ease-in-out;
}
@keyframes reactorSpinCW {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
@keyframes reactorSpinCCW {
  from { transform: rotate(0deg); }
  to { transform: rotate(-360deg); }
}
@keyframes geminiBreath {
  0%, 100% { transform: scale(0.96) rotate(0deg); opacity: 0.85; }
  50% { transform: scale(1.12) rotate(10deg); opacity: 1; filter: drop-shadow(0 0 25px #ff007f); }
}

/* Eyebrow & Live Pulse Dot */
.pf-preloader-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #00f2fe;
  box-shadow: 0 0 10px #00f2fe;
  animation: preloaderDotPulse 1.8s infinite;
}
@keyframes preloaderDotPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.7); }
}
.pf-preloader-eyebrow {
  font-size: 0.78rem;
  letter-spacing: 0.25em;
  color: #00f2fe;
  text-shadow: 0 0 12px rgba(0, 242, 254, 0.6);
}

/* Laser Scanline Beam Across Name */
.pf-name-laser-beam {
  height: 2px;
  width: 100%;
  background: linear-gradient(90deg, transparent 5%, #00f2fe 35%, #ff007f 65%, transparent 95%);
  box-shadow: 0 0 14px #00f2fe;
  animation: laserSweep 3s infinite ease-in-out;
}
.top-laser { margin-bottom: 8px; opacity: 0.75; }
.bottom-laser { margin-top: 8px; opacity: 0.85; width: 85%; margin-left: auto; margin-right: auto; }
@keyframes laserSweep {
  0%, 100% { transform: scaleX(0.75); opacity: 0.4; }
  50% { transform: scaleX(1.05); opacity: 1; filter: drop-shadow(0 0 10px #ff007f); }
}

/* 3D Kinetic Name Typography */
.pf-preloader-name {
  font-family: var(--font-hero, 'Syne', sans-serif);
  font-size: clamp(2.4rem, 6.8vw, 5.2rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: nowrap;
}
.name-word {
  display: inline-flex;
  white-space: nowrap;
}

/* Individual Interactive Animated Characters */
.p-char {
  display: inline-block;
  background: linear-gradient(135deg, #ffffff 15%, #00f2fe 60%, #4facfe 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  filter: drop-shadow(0 0 20px rgba(0, 242, 254, 0.45));
  opacity: 0;
  transform: translateY(35px) rotateX(-80deg) scale(0.7);
  animation: 
    charEntrance 0.75s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
    charShine 6s linear infinite;
  animation-delay: calc(var(--d) * 0.08s);
}

/* Accent Word (SONI) - Tri-Color Gradient */
.p-accent {
  background: linear-gradient(135deg, #00f2fe 0%, #4facfe 40%, #ff007f 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  filter: drop-shadow(0 0 20px rgba(255, 0, 127, 0.45));
}

@keyframes charEntrance {
  to {
    opacity: 1;
    transform: translateY(0) rotateX(0deg) scale(1);
  }
}
@keyframes charShine {
  0% { background-position: 0% 50%; }
  100% { background-position: 200% 50%; }
}

/* Floating Sparkle Star Beside Name */
.pf-sparkle-star {
  font-size: clamp(1.4rem, 3.5vw, 2.4rem);
  color: #ff007f;
  margin-left: 8px;
  display: inline-block;
  animation: starOrbit 3s ease-in-out infinite;
  filter: drop-shadow(0 0 12px #ff007f);
}
@keyframes starOrbit {
  0%, 100% { transform: translateY(0) rotate(0deg) scale(1); opacity: 0.7; }
  50% { transform: translateY(-8px) rotate(45deg) scale(1.25); opacity: 1; color: #00f2fe; filter: drop-shadow(0 0 16px #00f2fe); }
}

.pf-preloader-sub {
  font-size: clamp(0.72rem, 1.8vw, 0.85rem);
  letter-spacing: 0.16em;
  color: rgba(255, 255, 255, 0.75);
}

/* Real-Time Progress Bar */
.pf-preloader-progress-wrap {
  width: min(360px, 86vw);
}
.pf-status-line {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.04em;
}
.pf-preloader-bar-track {
  width: 100%;
  height: 6px;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid rgba(0, 242, 254, 0.25);
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.5);
}
.pf-preloader-bar-fill {
  width: 0%;
  height: 100%;
  background: linear-gradient(90deg, #00f2fe 0%, #4facfe 50%, #ff007f 100%);
  border-radius: 20px;
  position: relative;
  transition: width 0.12s linear;
}
.pf-bar-laser {
  position: absolute;
  top: 0;
  right: 0;
  width: 14px;
  height: 100%;
  background: #ffffff;
  box-shadow: 0 0 10px #ffffff, 0 0 20px #00f2fe;
}

/* Mobile Screen Breakpoint Tweaks */
@media (max-width: 576px) {
  .pf-preloader-name {
    flex-wrap: wrap;
    row-gap: 2px;
  }
  .p-space { display: inline-block; width: 6px; }
  .pf-sparkle-star { margin-left: 4px; }
}
</style>

<!-- ===================== JAVASCRIPT ===================== -->
<script>
(function() {
  // Lock body scroll immediately during entrance
  document.body.style.overflow = 'hidden';

  const preloader = document.getElementById('pfPreloader');
  const percentText = document.getElementById('pfBootPercent');
  const barFill = document.getElementById('pfBootBar');
  const statusText = document.getElementById('pfBootStatus');

  const bootStages = [
    { p: 20, msg: "INITIALIZING NODE.JS CORE..." },
    { p: 45, msg: "MOUNTING EXPRESS CONTROLLERS..." },
    { p: 70, msg: "SYNCING DATABASE SCHEMAS..." },
    { p: 90, msg: "CONFIGURING REST ARCHITECTURE..." },
    { p: 100, msg: "LAUNCHING MOHIT'S PORTFOLIO..." }
  ];

  let currentPercent = 0;
  let stageIdx = 0;

  // Deliberate cinematic timer (approx. 2.2 - 2.5 seconds total)
  const timer = setInterval(() => {
    // Smoother non-linear step curve
    const step = currentPercent < 70 ? Math.floor(Math.random() * 4) + 3 : Math.floor(Math.random() * 3) + 2;
    currentPercent += step;

    if (currentPercent > 100) currentPercent = 100;

    // Update Visuals
    if (barFill) barFill.style.width = currentPercent + '%';
    if (percentText) percentText.textContent = currentPercent + '%';

    // Cycle stage statuses
    if (statusText && stageIdx < bootStages.length) {
      if (currentPercent >= bootStages[stageIdx].p) {
        statusText.textContent = bootStages[stageIdx].msg;
        stageIdx++;
      }
    }

    // Complete Sequence
    if (currentPercent >= 100) {
      clearInterval(timer);
      setTimeout(() => {
        if (preloader) {
          preloader.classList.add('loaded');
          // Smooth unlock for document body
          document.body.style.overflow = '';
          
          // Trigger AOS refresh if library is available
          if (typeof AOS !== 'undefined') {
            AOS.refresh();
          }
        }
      }, 450);
    }
  }, 45);

  // Safety Fallback: Ensure curtain unlocks even on slow networks
  window.addEventListener('load', () => {
    setTimeout(() => {
      if (preloader && !preloader.classList.contains('loaded')) {
        clearInterval(timer);
        if (barFill) barFill.style.width = '100%';
        if (percentText) percentText.textContent = '100%';
        preloader.classList.add('loaded');
        document.body.style.overflow = '';
      }
    }, 3200);
  });
})();
</script>