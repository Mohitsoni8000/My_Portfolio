<!-- ===================== STYLES ===================== -->
<style>
/* Ambient Mesh Blobs */
.pf-ambient-blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(120px);
  z-index: 1;
}
.top-blob {
  width: 450px;
  height: 450px;
  top: -50px;
  left: -50px;
  background: radial-gradient(circle, rgba(0, 210, 255, 0.12) 0%, transparent 70%);
}
.center-blob {
  width: 700px;
  height: 700px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(58, 123, 213, 0.12) 0%, transparent 70%);
}
.bottom-blob {
  width: 500px;
  height: 500px;
  bottom: -50px;
  right: -50px;
  background: radial-gradient(circle, rgba(255, 107, 157, 0.08) 0%, transparent 70%);
}

/* Badge Pill */
.pf-badge-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.15);
  padding: 6px 16px;
  border-radius: 30px;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--accent, #00d2ff);
}
.pulsing-dot {
  width: 8px;
  height: 8px;
  background-color: var(--accent, #00d2ff);
  border-radius: 50%;
  box-shadow: 0 0 10px var(--accent, #00d2ff);
  animation: pulse-ring 2s infinite;
}
@keyframes pulse-ring {
  0% { transform: scale(0.95); opacity: 0.8; }
  50% { transform: scale(1.4); opacity: 0.3; }
  100% { transform: scale(0.95); opacity: 0.8; }
}

/* Gradient Heading */
.pf-gradient-heading {
  background: linear-gradient(135deg, #ffffff 40%, rgba(0, 210, 255, 0.85) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* 3D Glass Card Container with Gyroscope & Spotlight */
.pf-card-3d {
  position: relative;
  border-radius: 24px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  transform-style: preserve-3d;
  perspective: 1000px;
  overflow: hidden;
  transition: transform 0.15s ease-out, border-color 0.4s ease, box-shadow 0.4s ease;
}
.card-glow-tracker {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle 200px at var(--mouse-x, -500px) var(--mouse-y, -500px), var(--card-glow, rgba(0, 210, 255, 0.15)), transparent 80%);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
  z-index: 1;
}
.pf-card-3d:hover .card-glow-tracker {
  opacity: 1;
}
.pf-card-3d:hover {
  border-color: rgba(255, 255, 255, 0.25);
  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
}
.card-inner-content {
  position: relative;
  z-index: 2;
  transform: translateZ(25px);
  transition: transform 0.25s ease-out;
}

/* Progress Bar Improvements */
.pf-progress-container {
  height: 8px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  overflow: hidden;
}
.pf-progress-fill {
  width: 0%;
  border-radius: 12px;
  position: relative;
  overflow: hidden;
  transition: width 1.8s cubic-bezier(0.25, 1, 0.5, 1);
}
.progress-shimmer {
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: shimmer 2.2s infinite;
}
@keyframes shimmer {
  100% { left: 100%; }
}

/* Feature Sub-cards */
.pf-feature-box {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.07);
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}
.pf-feature-box:hover {
  transform: translateY(-5px);
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(0, 210, 255, 0.5);
  box-shadow: 0 10px 20px rgba(0, 210, 255, 0.12);
}
.extra-small {
  font-size: 0.72rem;
}
.tracking-wider {
  letter-spacing: 0.75px;
}
</style>

<!-- ===================== JAVASCRIPT ===================== -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  // 1. Interactive 3D Card Hover & Mouse Spotlight Tracker
  const cards = document.querySelectorAll('.pf-card-3d');

  cards.forEach(card => {
    const glowColor = card.getAttribute('data-glow-color') || 'rgba(0, 210, 255, 0.2)';
    card.style.setProperty('--card-glow', glowColor);

    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);

      // 3D Tilt calculation
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -10;
      const rotateY = ((x - centerX) / centerX) * 10;

      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
    });

    card.addEventListener('mouseleave', () => {
      card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
    });
  });

  // 2. Viewport-Triggered Counter & Progress Bar Animations
  let animationTriggered = false;
  const section = document.querySelector('#about');

  const runAnimations = () => {
    // Fill Progress Bars
    const progressBars = document.querySelectorAll('.pf-progress-fill');
    progressBars.forEach(bar => {
      const target = bar.getAttribute('data-width');
      bar.style.width = target;
    });

    // Counting Numbers
    const counters = document.querySelectorAll('.pf-stat[data-counter]');
    counters.forEach(counter => {
      const target = +counter.getAttribute('data-counter');
      const duration = 1600; // ms
      const startTime = performance.now();

      const updateCount = (currentTime) => {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        // Easing out function
        const easedProgress = 1 - Math.pow(1 - progress, 3);
        const currentVal = Math.floor(easedProgress * target);

        counter.innerText = currentVal + (target >= 10 ? '+' : '');

        if (progress < 1) {
          requestAnimationFrame(updateCount);
        } else {
          counter.innerText = target + (target >= 10 ? '+' : '');
        }
      };

      requestAnimationFrame(updateCount);
    });
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !animationTriggered) {
        runAnimations();
        animationTriggered = true;
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.25 });

  if (section) observer.observe(section);
});
</script>