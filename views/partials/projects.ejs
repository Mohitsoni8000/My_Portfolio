<!-- ===================== Scripts for Timer & Filtering ===================== -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const carouselEl = document.getElementById('pfProjectCarousel');
    const progressBar = document.getElementById('carouselTimer');
    const intervalTime = 4500;
    let timerStartTime = Date.now();
    let animFrame;

    // 1. Synchronized visual progress bar
    function updateProgress() {
      const elapsed = Date.now() - timerStartTime;
      const progress = Math.min((elapsed / intervalTime) * 100, 100);
      if (progressBar) progressBar.style.width = progress + '%';

      if (progress < 100) {
        animFrame = requestAnimationFrame(updateProgress);
      }
    }

    function resetTimer() {
      timerStartTime = Date.now();
      cancelAnimationFrame(animFrame);
      updateProgress();
    }

    if (carouselEl && typeof bootstrap !== 'undefined') {
      const bsCarousel = new bootstrap.Carousel(carouselEl, {
        interval: intervalTime,
        ride: 'carousel',
        pause: 'hover',
        wrap: true
      });

      resetTimer();

      carouselEl.addEventListener('slide.bs.carousel', function (e) {
        // Sync custom indicators
        const dots = document.querySelectorAll('.pf-carousel-dot');
        dots.forEach((dot, idx) => {
          dot.classList.toggle('active', idx === e.to);
        });
        resetTimer();
      });

      // Pause timer on hover
      carouselEl.addEventListener('mouseenter', () => cancelAnimationFrame(animFrame));
      carouselEl.addEventListener('mouseleave', () => resetTimer());
    }

    // 2. Interactive Category Filter System
    const filterButtons = document.querySelectorAll('.pf-filter-btn');
    const projectCards = document.querySelectorAll('.pf-proj-col');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', function () {
        filterButtons.forEach(b => b.classList.remove('active'));
        this.classList.add('active');

        const filter = this.getAttribute('data-filter');

        projectCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.opacity = '1';
            card.style.transform = 'scale(1)';
            card.style.pointerEvents = 'all';
          } else {
            card.style.opacity = '0.15';
            card.style.transform = 'scale(0.96)';
            card.style.pointerEvents = 'none';
          }
        });
      });
    });
  });
</script>