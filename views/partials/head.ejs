<!-- ===================== views/partials/head.ejs ===================== -->
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<meta name="description" content="<%= description %>" />

<!-- Google Fonts: Syne (Ultra-Modern Display) + Plus Jakarta Sans + Sora + JetBrains Mono -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Sora:wght@400;600;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet">

<!-- Vendor Stylesheets -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
<link href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.1/aos.css" rel="stylesheet">

<style>
/* ==========================================================================
   CSS CUSTOM VARIABLES & DESIGN TOKENS
   ========================================================================== */
:root {
  --bg: #05070e;
  --bg-2: #090e1c;
  --surface: rgba(13, 19, 36, 0.72);
  --surface-2: rgba(22, 32, 60, 0.75);
  --surface-solid: #0e1529;
  --text: #f8fafc;
  --text-muted: #94a3b8;
  --accent: #00f2fe;
  --accent-soft: rgba(0, 242, 254, 0.22);
  --accent-2: #4facfe;
  --accent-2-soft: rgba(79, 172, 254, 0.22);
  --accent-3: #ff007f;
  --accent-3-soft: rgba(255, 0, 127, 0.2);
  --accent-glow: 0 0 35px rgba(0, 242, 254, 0.45);
  --border: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(0, 242, 254, 0.35);
  --border-gradient: linear-gradient(135deg, rgba(0, 242, 254, 0.5), rgba(255, 0, 127, 0.3), transparent 70%);
  --shadow-3d: 0 30px 60px -12px rgba(0, 0, 0, 0.8), 0 0 40px -10px rgba(0, 242, 254, 0.15);
  --grid-line: rgba(255, 255, 255, 0.025);
  
  --font-hero: 'Syne', sans-serif;
  --font-display: 'Sora', sans-serif;
  --font-body: 'Plus Jakarta Sans', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  --transition-theme: 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

[data-theme="light"] {
  --bg: #f8fafc;
  --bg-2: #ffffff;
  --surface: rgba(255, 255, 255, 0.85);
  --surface-2: #f1f5f9;
  --surface-solid: #ffffff;
  --text: #0f172a;
  --text-muted: #64748b;
  --accent: #0284c7;
  --accent-soft: rgba(2, 132, 199, 0.12);
  --accent-2: #4f46e5;
  --accent-2-soft: rgba(79, 70, 229, 0.14);
  --accent-3: #e11d48;
  --accent-3-soft: rgba(225, 29, 72, 0.12);
  --accent-glow: 0 0 25px rgba(2, 132, 199, 0.25);
  --border: rgba(15, 23, 42, 0.08);
  --border-strong: rgba(2, 132, 199, 0.35);
  --border-gradient: linear-gradient(135deg, rgba(2, 132, 199, 0.4), rgba(79, 70, 229, 0.3), transparent 70%);
  --shadow-3d: 0 25px 50px -12px rgba(15, 23, 42, 0.08), 0 0 25px rgba(2, 132, 199, 0.08);
  --grid-line: rgba(15, 23, 42, 0.03);
}

/* ==========================================================================
   GLOBAL RESET & SMOOTH SCROLLING
   ========================================================================== */
*, *::before, *::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
}

body {
  background-color: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  overflow-x: hidden;
  transition: background-color var(--transition-theme), color var(--transition-theme);
  position: relative;
  letter-spacing: -0.01em;
  line-height: 1.65;
}

/* Custom Cyber Scrollbar */
::-webkit-scrollbar {
  width: 10px;
}
::-webkit-scrollbar-track {
  background: var(--bg);
}
::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, var(--accent), var(--accent-2));
  border-radius: 8px;
  border: 2px solid var(--bg);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--accent);
}

/* ==========================================================================
   PERSPECTIVE BACKGROUND GRID & KINETIC ORBS
   ========================================================================== */
.pf-ambient-canvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: -2;
  pointer-events: none;
  overflow: hidden;
}

.pf-grid-mesh {
  position: absolute;
  inset: 0;
  background-image: 
    linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
    linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
  background-size: 55px 55px;
  mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
  -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
}

.pf-kinetic-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(140px);
  opacity: 0.35;
  mix-blend-mode: screen;
  will-change: transform;
}
.orb-1 {
  width: 650px;
  height: 650px;
  background: radial-gradient(circle, var(--accent) 0%, transparent 75%);
  top: -150px;
  left: -150px;
  animation: kineticFloat1 20s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
}
.orb-2 {
  width: 750px;
  height: 750px;
  background: radial-gradient(circle, var(--accent-2) 0%, transparent 75%);
  bottom: -200px;
  right: -150px;
  animation: kineticFloat2 24s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
}
.orb-3 {
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, var(--accent-3) 0%, transparent 75%);
  top: 40%;
  left: 35%;
  opacity: 0.18;
  animation: kineticFloat3 18s ease-in-out infinite alternate;
}

@keyframes kineticFloat1 {
  0% { transform: translate(0, 0) scale(1) rotate(0deg); }
  100% { transform: translate(120px, 100px) scale(1.15) rotate(45deg); }
}
@keyframes kineticFloat2 {
  0% { transform: translate(0, 0) scale(1) rotate(0deg); }
  100% { transform: translate(-100px, -80px) scale(1.2) rotate(-45deg); }
}
@keyframes kineticFloat3 {
  0% { transform: translate(-50%, -50%) scale(0.9); }
  100% { transform: translate(-30%, -40%) scale(1.2); }
}

/* ==========================================================================
   TYPOGRAPHY & GRADIENT GLOW HEADINGS
   ========================================================================== */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
  letter-spacing: -0.03em;
  color: var(--text);
  font-weight: 700;
}

.pf-hero-heading {
  font-family: var(--font-hero);
  font-size: clamp(2.8rem, 6.5vw, 5.5rem);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.04em;
}

/* Dynamic Moving Gradient Text */
.pf-text-gradient {
  background: linear-gradient(135deg, #ffffff 0%, var(--accent) 50%, var(--accent-2) 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  display: inline-block;
  animation: textShine 8s linear infinite;
}
@keyframes textShine {
  to { background-position: 200% center; }
}

.pf-text-gradient-fire {
  background: linear-gradient(135deg, #ff007f 0%, #ff8c00 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.pf-mono { font-family: var(--font-mono); }
a { text-decoration: none; color: inherit; }

/* Eyebrow Label with Animated Neon Dash */
.pf-eyebrow {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--accent);
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
  font-weight: 600;
}
.pf-eyebrow::before {
  content: '';
  width: 28px;
  height: 2px;
  background: var(--accent);
  box-shadow: var(--accent-glow);
  border-radius: 4px;
}

/* ==========================================================================
   CYBER GLASSMORPHISM & 3D HOVER ENGINE
   ========================================================================== */
.glass-panel {
  background: var(--surface);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-3d);
  border-radius: 24px;
  position: relative;
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}

.glass-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 24px;
  padding: 1px;
  background: var(--border-gradient);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  opacity: 0.6;
  transition: opacity 0.4s ease;
}

.glass-panel:hover::before {
  opacity: 1;
}

/* 3D Depth Card Class */
.hover-3d {
  transform-style: preserve-3d;
  perspective: 1200px;
  transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.45s ease;
  will-change: transform;
}
.hover-3d:hover {
  transform: translateY(-8px) scale3d(1.01, 1.01, 1.01) rotateX(3deg) rotateY(-3deg);
  box-shadow: 0 35px 80px -15px rgba(0, 0, 0, 0.8), 0 0 35px rgba(0, 242, 254, 0.25);
  border-color: var(--border-strong);
}

/* ==========================================================================
   MODERN NAVBAR & FLOATING ISLAND DESIGN
   ========================================================================== */
.pf-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  padding: 24px 0;
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.pf-navbar.scrolled {
  padding: 14px 0;
  background: color-mix(in srgb, var(--bg) 75%, transparent);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1px solid var(--border);
  box-shadow: 0 15px 40px -10px rgba(0, 0, 0, 0.5);
}

.pf-logo {
  font-family: var(--font-hero);
  font-weight: 800;
  font-size: 1.65rem;
  letter-spacing: -0.03em;
  display: flex;
  align-items: center;
  gap: 8px;
}
.pf-logo span {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  filter: drop-shadow(0 0 15px var(--accent-soft));
}

.pf-nav-link {
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--text-muted);
  margin: 0 16px;
  position: relative;
  padding: 8px 4px;
  transition: color 0.3s ease;
}
.pf-nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  border-radius: 4px;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  transform: translateX(-50%);
  box-shadow: var(--accent-glow);
}
.pf-nav-link:hover, .pf-nav-link.active {
  color: var(--text);
}
.pf-nav-link:hover::after, .pf-nav-link.active::after {
  width: 100%;
}

/* Magnetic Theme Switcher */
.pf-theme-toggle {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  backdrop-filter: blur(12px);
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 8px 20px rgba(0,0,0,0.15);
}
.pf-theme-toggle:hover {
  transform: scale(1.1) rotate(15deg);
  border-color: var(--accent);
  box-shadow: var(--accent-glow);
  color: var(--accent);
}

/* ==========================================================================
   HYPER-TACTILE BUTTONS (PULSE, SHIMMER & MAGNET)
   ========================================================================== */
.pf-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 14px 34px;
  border-radius: 100px;
  font-weight: 600;
  font-size: 0.95rem;
  letter-spacing: -0.01em;
  border: none;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  z-index: 1;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.pf-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
  transition: left 0.6s ease;
  z-index: -1;
}
.pf-btn:hover::before {
  left: 100%;
}

.pf-btn-primary {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
  color: #05070e;
  font-weight: 700;
  box-shadow: 0 10px 30px var(--accent-soft);
}
.pf-btn-primary:hover {
  transform: translateY(-4px) scale(1.02);
  box-shadow: 0 20px 45px var(--accent-soft), var(--accent-glow);
  color: #000;
}

.pf-btn-outline {
  background: var(--surface);
  border: 1px solid var(--border-strong);
  color: var(--text);
  backdrop-filter: blur(10px);
}
.pf-btn-outline:hover {
  transform: translateY(-4px);
  border-color: var(--accent);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
  color: var(--accent);
}

/* ==========================================================================
   INPUT CONTROLS & FOOTER STYLES
   ========================================================================== */
.pf-form-control {
  background: var(--surface-2);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 16px;
  padding: 16px 22px;
  width: 100%;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  backdrop-filter: blur(10px);
}
.pf-form-control:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 4px var(--accent-soft), var(--accent-glow);
  background: var(--surface);
  color: var(--text);
}

/* Modernized Scroll-to-Top */
.pf-back-top {
  position: fixed;
  bottom: 32px;
  right: 32px;
  width: 52px;
  height: 52px;
  border-radius: 18px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #05070e;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px) scale(0.8);
  transition: all 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  border: none;
  cursor: pointer;
  box-shadow: 0 12px 35px var(--accent-soft);
  font-size: 1.25rem;
}
.pf-back-top.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}
.pf-back-top:hover {
  transform: translateY(-6px) scale(1.12);
  box-shadow: 0 20px 45px var(--accent-soft), var(--accent-glow);
  color: #000;
}
</style>
</head>
<body>
  <!-- Atmospheric Spatial Background Mesh & Floating Kinetic Glows -->
  <div class="pf-ambient-canvas">
    <div class="pf-grid-mesh"></div>
    <div class="pf-kinetic-orb orb-1"></div>
    <div class="pf-kinetic-orb orb-2"></div>
    <div class="pf-kinetic-orb orb-3"></div>
  </div>