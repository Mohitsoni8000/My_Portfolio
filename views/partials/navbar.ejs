<!-- ===================== views/partials/navbar.ejs ===================== -->
<nav class="navbar navbar-expand-lg pf-navbar fixed-top w-100" id="pfNavbar">
  <div class="container-xl px-3 px-sm-4 px-lg-5 d-flex align-items-center justify-content-between">
    
    <!-- Holographic Brand Reactor Logo -->
    <a href="#home" class="navbar-brand pf-logo text-decoration-none d-flex align-items-center gap-2 m-0 p-0" id="pfNavBrand">
      <div class="pf-logo-hex-wrap flex-shrink-0">
        <div class="pf-hex-glow"></div>
        <div class="pf-hex-inner">
          <i class="bi bi-terminal-fill pf-logo-icon"></i>
        </div>
      </div>
      <div class="d-flex flex-column text-start">
        <span class="pf-brand-name">M<span class="pf-brand-highlight">S</span><span class="pf-brand-dot">.</span></span>
        <span class="pf-brand-sub pf-mono d-none d-sm-inline">DEV // v2.6</span>
      </div>
    </a>

    <!-- Center Desktop Floating Glass Island with Sliding Liquid Indicator -->
    <div class="collapse navbar-collapse justify-content-center d-none d-lg-flex" id="pfDesktopNavCollapse">
      <div class="pf-nav-island position-relative" id="pfNavIsland">
        <!-- Floating Liquid Pill Background Tracker -->
        <span class="pf-liquid-pill" id="pfLiquidPill"></span>

        <ul class="navbar-nav align-items-center mb-0 gap-1 position-relative" style="z-index: 2;">
          <% 
            const navIcons = {
              'Home': 'bi bi-grid-1x2-fill',
              'About': 'bi bi-person-bounding-box',
              'Skills': 'bi bi-cpu-fill',
              'Projects': 'bi bi-code-slash',
              'Contact': 'bi bi-chat-square-quote-fill'
            };
          %>
          <% nav.forEach(function (item, i) { %>
            <li class="nav-item">
              <a href="<%= item.href %>" 
                 class="nav-link pf-nav-item text-light px-3 py-2 fw-semibold d-flex align-items-center gap-2 <%= i === 0 ? 'active' : '' %>"
                 data-nav-target="<%= item.href.replace('#', '') %>">
                <i class="<%= navIcons[item.label] || 'bi bi-diamond-fill' %> pf-nav-ico"></i>
                <span class="pf-nav-label"><%= item.label %></span>
              </a>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>

    <!-- Right Side Actions: Marquee, Quick Action & Mobile Toggle -->
    <div class="d-flex align-items-center gap-2 gap-sm-3 flex-shrink-0">
      
      <!-- Live AI System Ping Marquee Ticker (Large Screens Only) -->
      <div class="pf-ai-status-marquee d-none d-xl-flex align-items-center gap-2 px-3 py-1 rounded-pill">
        <span class="pf-ai-dot flex-shrink-0"></span>
        <div class="pf-marquee-track">
          <span class="pf-mono extra-small text-cyan">SYS::ONLINE</span>
          <span class="pf-mono extra-small text-muted opacity-75">•</span>
          <span class="pf-mono extra-small text-light">LATENCY: 14ms</span>
          <span class="pf-mono extra-small text-muted opacity-75">•</span>
          <span class="pf-mono extra-small text-magenta">OPEN FOR CONTRACT</span>
        </div>
      </div>

      <!-- Quick Action Connect Button (Hidden on tiny phones, visible from 480px up) -->
      <a href="https://wa.me/918000225896?text=Welcome%20to%20my%20portfolio%20website!%20How%20can%20I%20help%20you%20sir%3F" 
         target="_blank" 
         rel="noopener noreferrer"
         class="pf-talk-btn d-none d-sm-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill text-decoration-none">
        <i class="bi bi-lightning-charge-fill text-cyan"></i>
        <span class="small fw-bold">Let's Talk</span>
      </a>

      <!-- Mobile Offcanvas Hamburger Button -->
      <button class="navbar-toggler border-0 p-2 rounded-3 shadow-none d-lg-none pf-mobile-toggle-btn" 
              type="button" 
              data-bs-toggle="offcanvas" 
              data-bs-target="#pfMobileNav" 
              aria-controls="pfMobileNav" 
              aria-label="Toggle navigation">
        <div class="hamburger-box">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </div>
      </button>

    </div>

  </div>
</nav>

<!-- ===================== MOBILE OFFCANVAS DRAWER ===================== -->
<div class="offcanvas offcanvas-end pf-mobile-offcanvas" tabindex="-1" id="pfMobileNav" aria-labelledby="pfMobileNavLabel">
  
  <div class="offcanvas-header border-bottom border-white border-opacity-10 pb-3 px-3 px-sm-4 pt-4">
    <div class="d-flex align-items-center gap-2">
      <div class="pf-logo-hex-wrap flex-shrink-0" style="width:34px; height:34px;">
        <div class="pf-hex-inner" style="font-size:0.85rem;">
          <i class="bi bi-terminal-fill pf-logo-icon"></i>
        </div>
      </div>
      <div>
        <h5 class="pf-brand-name mb-0 fs-5" id="pfMobileNavLabel">M<span class="pf-brand-highlight">S</span><span class="pf-brand-dot">.</span></h5>
        <span class="pf-brand-sub pf-mono" style="font-size:0.65rem;">MOBILE NAVIGATION</span>
      </div>
    </div>
    <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>

  <div class="offcanvas-body d-flex flex-column justify-content-between px-3 px-sm-4 py-4 overflow-y-auto">
    <!-- Links List -->
    <ul class="navbar-nav flex-column gap-2 mb-0 w-100 p-0">
      <% nav.forEach(function (item) { %>
        <li class="nav-item w-100">
          <a href="<%= item.href %>" 
             class="nav-link pf-mobile-item-link px-3 py-3 rounded-4 d-flex align-items-center justify-content-between text-light text-decoration-none w-100"
             data-mobile-target="<%= item.href %>">
            <div class="d-flex align-items-center gap-3">
              <span class="pf-mobile-ico-box flex-shrink-0">
                <i class="<%= navIcons[item.label] || 'bi bi-folder-fill' %>"></i>
              </span>
              <span class="fw-semibold"><%= item.label %></span>
            </div>
            <i class="bi bi-chevron-right text-cyan opacity-50 pf-chevron"></i>
          </a>
        </li>
      <% }); %>
    </ul>

    <!-- Bottom Action Drawer Card -->
    <div class="pt-3 border-top border-white border-opacity-10 mt-auto">
      <div class="p-3 rounded-4 mb-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(0, 242, 254, 0.15);">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="pf-mono text-cyan extra-small">DEVELOPER ONLINE</span>
          <span class="pf-pulse-indicator"></span>
        </div>
        <p class="text-light opacity-50 mb-0" style="font-size:0.75rem;">Fastest responses via direct WhatsApp chat</p>
      </div>

      <a href="https://wa.me/918000225896?text=Welcome%20to%20my%20portfolio%20website!%20How%20can%20I%20help%20you%20sir%3F" 
         target="_blank" 
         rel="noopener noreferrer"
         class="w-100 pf-btn-mobile-chat py-3 fw-bold d-flex align-items-center justify-content-center gap-2 text-decoration-none rounded-pill">
        <i class="bi bi-whatsapp fs-5"></i> Chat on WhatsApp
      </a>
    </div>
  </div>

</div>

<!-- ===================== COMPONENT STYLES ===================== -->
<style>
/* Universal Box Model Hardening */
*, *::before, *::after {
  box-sizing: border-box;
}

/* Base Navbar Container */
.pf-navbar {
  padding: 16px 0;
  background: rgba(5, 7, 14, 0.4);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  transition: padding 0.35s ease, background 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  z-index: 1050;
  max-width: 100vw;
}

.pf-navbar.scrolled {
  padding: 10px 0;
  background: rgba(5, 7, 14, 0.88);
  backdrop-filter: blur(28px) saturate(180%);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  border-bottom: 1px solid rgba(0, 242, 254, 0.2);
  box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.85), 0 0 20px rgba(0, 242, 254, 0.08);
}

/* Holographic 3D Hex Logo */
.pf-logo-hex-wrap {
  position: relative;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pf-hex-glow {
  position: absolute;
  inset: -2px;
  border-radius: 10px;
  background: linear-gradient(135deg, #00f2fe, #ff007f);
  filter: blur(6px);
  opacity: 0.4;
  transition: opacity 0.3s ease;
}
.pf-hex-inner {
  position: relative;
  width: 100%;
  height: 100%;
  background: rgba(13, 19, 36, 0.95);
  border: 1px solid rgba(0, 242, 254, 0.4);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.pf-logo-icon {
  color: #00f2fe;
  font-size: 1rem;
  filter: drop-shadow(0 0 6px rgba(0, 242, 254, 0.8));
}
.pf-logo:hover .pf-hex-inner {
  transform: rotate(10deg) scale(1.05);
  border-color: #00f2fe;
}
.pf-logo:hover .pf-hex-glow {
  opacity: 0.85;
}
.pf-brand-name {
  font-family: var(--font-hero, 'Syne', sans-serif);
  font-weight: 800;
  font-size: 1.25rem;
  letter-spacing: -0.03em;
  color: #fff;
  line-height: 1.1;
}
.pf-brand-highlight {
  background: linear-gradient(135deg, #00f2fe, #4facfe);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.pf-brand-dot {
  color: #ff007f;
}
.pf-brand-sub {
  font-size: 0.62rem;
  letter-spacing: 0.14em;
  color: var(--text-muted, #94a3b8);
}

/* Center Desktop Island */
.pf-nav-island {
  background: rgba(13, 19, 36, 0.72);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 100px;
  padding: 4px 6px;
  box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.1);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}
.pf-nav-island:hover {
  border-color: rgba(0, 242, 254, 0.35);
  box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.8), 0 0 25px rgba(0, 242, 254, 0.15);
}

/* Sliding Liquid Pill Tracker */
.pf-liquid-pill {
  position: absolute;
  top: 4px;
  left: 0;
  height: calc(100% - 8px);
  width: 0;
  background: linear-gradient(135deg, rgba(0, 242, 254, 0.18), rgba(79, 172, 254, 0.25));
  border: 1px solid rgba(0, 242, 254, 0.45);
  box-shadow: 0 0 15px rgba(0, 242, 254, 0.25);
  border-radius: 100px;
  pointer-events: none;
  z-index: 1;
  opacity: 0;
  transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
}

/* Desktop Nav Items */
.pf-nav-item {
  font-size: 0.85rem;
  letter-spacing: -0.01em;
  color: var(--text-muted, #94a3b8) !important;
  border-radius: 100px;
  transition: color 0.3s ease;
  white-space: nowrap;
}
.pf-nav-item:hover,
.pf-nav-item.active {
  color: #fff !important;
}
.pf-nav-ico {
  font-size: 0.88rem;
  color: var(--text-muted, #94a3b8);
  transition: color 0.3s ease, transform 0.3s ease;
}
.pf-nav-item:hover .pf-nav-ico,
.pf-nav-item.active .pf-nav-ico {
  color: #00f2fe;
  transform: scale(1.12);
}

/* System Ping Marquee */
.pf-ai-status-marquee {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(10px);
  max-width: 220px;
  overflow: hidden;
}
.pf-ai-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #00f2fe;
  box-shadow: 0 0 8px #00f2fe;
  animation: radarDot 1.8s infinite;
}
@keyframes radarDot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.8); }
}
.pf-marquee-track {
  display: flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
  animation: marqueeGlide 16s linear infinite;
}
@keyframes marqueeGlide {
  0% { transform: translateX(0%); }
  100% { transform: translateX(-50%); }
}

/* Quick Action Button */
.pf-talk-btn {
  background: rgba(0, 242, 254, 0.08);
  border: 1px solid rgba(0, 242, 254, 0.3);
  color: #fff !important;
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
  white-space: nowrap;
}
.pf-talk-btn:hover {
  background: linear-gradient(135deg, #00f2fe, #4facfe);
  border-color: #00f2fe;
  color: #05070e !important;
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0, 242, 254, 0.35);
}
.pf-talk-btn:hover .bi-lightning-charge-fill {
  color: #05070e !important;
}

/* Mobile Offcanvas Drawer - Responsive Width Guard */
.pf-mobile-offcanvas {
  background: rgba(5, 7, 14, 0.96) !important;
  backdrop-filter: blur(30px) saturate(180%);
  -webkit-backdrop-filter: blur(30px) saturate(180%);
  border-left: 1px solid rgba(0, 242, 254, 0.25) !important;
  width: min(320px, 85vw) !important;
  max-width: 100vw;
}

.pf-mobile-item-link {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.06);
  transition: all 0.25s ease;
}
.pf-mobile-ico-box {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #00f2fe;
}
.pf-mobile-item-link:hover,
.pf-mobile-item-link:active {
  background: linear-gradient(135deg, rgba(0, 242, 254, 0.15), rgba(79, 172, 254, 0.1));
  border-color: rgba(0, 242, 254, 0.5);
  color: #00f2fe !important;
  transform: translateX(4px);
}
.pf-mobile-item-link:hover .pf-mobile-ico-box {
  background: #00f2fe;
  color: #05070e;
}

/* Pulsing Status Dot in Mobile Drawer */
.pf-pulse-indicator {
  width: 7px;
  height: 7px;
  background-color: #00f2fe;
  border-radius: 50%;
  box-shadow: 0 0 10px #00f2fe;
}

/* Mobile CTA Button */
.pf-btn-mobile-chat {
  background: linear-gradient(135deg, #25d366, #128c7e);
  color: #fff !important;
  border: 1px solid #25d366;
  box-shadow: 0 10px 25px rgba(37, 211, 102, 0.35);
  transition: transform 0.25s ease;
}
.pf-btn-mobile-chat:active {
  transform: scale(0.97);
}

/* Hamburger Toggler Icon */
.pf-mobile-toggle-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(0, 242, 254, 0.25) !important;
}
.hamburger-box {
  width: 20px;
  height: 15px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.hamburger-line {
  display: block;
  width: 100%;
  height: 2px;
  background: #00f2fe;
  border-radius: 4px;
}

.extra-small { font-size: 0.72rem; }
.text-cyan { color: #00f2fe !important; }
.text-magenta { color: #ff007f !important; }
</style>

<!-- ===================== JAVASCRIPT ===================== -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const navbar = document.getElementById('pfNavbar');
  const pill = document.getElementById('pfLiquidPill');
  const navItems = document.querySelectorAll('.pf-nav-item');
  const navIsland = document.getElementById('pfNavIsland');
  const offcanvasEl = document.getElementById('pfMobileNav');

  // 1. Scroll-Triggered Navbar Glass Blur
  const handleScroll = () => {
    if (window.scrollY > 30) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  };
  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // 2. Liquid Tracker Pill (Only runs on desktop viewport >= 992px)
  const movePillTo = (element) => {
    if (!pill || !element || !navIsland || window.innerWidth < 992) return;
    const islandRect = navIsland.getBoundingClientRect();
    const itemRect = element.getBoundingClientRect();

    const left = itemRect.left - islandRect.left;
    const width = itemRect.width;

    pill.style.opacity = '1';
    pill.style.transform = `translateX(${left}px)`;
    pill.style.width = `${width}px`;
  };

  const activeItem = document.querySelector('.pf-nav-item.active');
  if (activeItem && window.innerWidth >= 992) {
    setTimeout(() => movePillTo(activeItem), 200);
  }

  navItems.forEach(item => {
    item.addEventListener('mouseenter', () => movePillTo(item));
    item.addEventListener('focus', () => movePillTo(item));
  });

  if (navIsland) {
    navIsland.addEventListener('mouseleave', () => {
      const currentActive = document.querySelector('.pf-nav-item.active');
      if (currentActive) {
        movePillTo(currentActive);
      } else {
        pill.style.opacity = '0';
      }
    });
  }

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 992) {
      const currentActive = document.querySelector('.pf-nav-item.active');
      if (currentActive) movePillTo(currentActive);
    } else if (pill) {
      pill.style.opacity = '0';
    }
  });

  // 3. Smooth Anchor Scroll & Offcanvas Auto-Close Mechanism
  const navigateTo = (targetId) => {
    const targetEl = document.querySelector(targetId);
    if (!targetEl) return;

    const navOffset = navbar ? navbar.offsetHeight : 70;
    const targetPosition = targetEl.getBoundingClientRect().top + window.pageYOffset - navOffset + 2;

    window.scrollTo({
      top: targetPosition,
      behavior: 'smooth'
    });
  };

  // Mobile navigation click handler
  document.querySelectorAll('[data-mobile-target]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('data-mobile-target');
      
      // Close Bootstrap offcanvas safely
      if (offcanvasEl && typeof bootstrap !== 'undefined') {
        const bsOffcanvas = bootstrap.Offcanvas.getInstance(offcanvasEl) || new bootstrap.Offcanvas(offcanvasEl);
        bsOffcanvas.hide();
      }

      setTimeout(() => navigateTo(targetId), 250);
    });
  });

  // Desktop navigation click handler
  navItems.forEach(link => {
    link.addEventListener('click', (e) => {
      const targetId = link.getAttribute('href');
      if (targetId && targetId.startsWith('#')) {
        e.preventDefault();
        navigateTo(targetId);
        navItems.forEach(n => n.classList.remove('active'));
        link.classList.add('active');
        movePillTo(link);
      }
    });
  });

  // 4. Viewport Intersection Observer (Scroll-Spy)
  const sections = document.querySelectorAll('section[id], header[id]');
  const spyObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        const matchedItem = document.querySelector(`.pf-nav-item[data-nav-target="${id}"]`);
        if (matchedItem) {
          navItems.forEach(n => n.classList.remove('active'));
          matchedItem.classList.add('active');
          if (window.innerWidth >= 992) movePillTo(matchedItem);
        }
      }
    });
  }, {
    rootMargin: '-25% 0px -65% 0px',
    threshold: 0
  });

  sections.forEach(sec => spyObserver.observe(sec));
});
</script>